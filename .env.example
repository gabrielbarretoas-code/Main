# Porta em que o servidor HTTP vai escutar
PORT=3000

# --- WhatsApp Business Platform (Meta for Developers) ---
# Token de acesso (temporário de teste ou permanente) do app no Meta for Developers
WHATSAPP_TOKEN=
# Phone Number ID do número de WhatsApp Business configurado no app
WHATSAPP_PHONE_NUMBER_ID=
# String que você escolhe e configura no painel do webhook da Meta (qualquer valor secreto seu)
WHATSAPP_VERIFY_TOKEN=
# App Secret do app na Meta, usado para validar a assinatura das requisições do webhook
WHATSAPP_APP_SECRET=

# --- Todoist ---
# Gerado em Todoist > Configurações > Integrações > Developer
TODOIST_API_TOKEN=

# --- Anthropic (opcional, mas recomendado) ---
# Usado para extrair título, prioridade e prazo da mensagem de forma inteligente.
# Sem essa chave, a automação usa uma classificação simples baseada em palavras-chave.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
