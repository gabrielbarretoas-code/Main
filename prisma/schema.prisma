generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Entity {
  PERSONAL
  BUSINESS
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum UserRole {
  OWNER
  MEMBER
}

enum RecurrenceFrequency {
  MONTHLY
}

enum LoanDirection {
  BORROWED
  LENT
}

model Organization {
  id                   String             @id @default(cuid())
  name                 String
  whatsappPhone        String?            @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())

  users                 User[]
  accounts              Account[]
  categories            Category[]
  costCenters           CostCenter[]
  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  loans                 Loan[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  role           UserRole     @default(OWNER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model Account {
  id             String        @id @default(cuid())
  name           String
  type           AccountType
  entity         Entity
  hasAutoInvest  Boolean       @default(false)
  creditLimit    Float?
  closingDay     Int?
  dueDay         Int?
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  transactions   Transaction[]
  recurringTransactions RecurringTransaction[]
  loans          Loan[]

  @@index([organizationId])
}

model Category {
  id             String          @id @default(cuid())
  name           String
  type           TransactionType
  entity         Entity
  color          String          @default("#6366f1")
  icon           String          @default("Tag")
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children       Category[]      @relation("CategoryHierarchy")
  transactions   Transaction[]
  budgets        Budget[]
  recurringTransactions RecurringTransaction[]
  loans          Loan[]

  @@unique([organizationId, name, type, entity])
  @@index([parentId])
}

model CostCenter {
  id             String        @id @default(cuid())
  name           String
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  recurringTransactions RecurringTransaction[]

  @@unique([organizationId, name])
}

model Transaction {
  id             String          @id @default(cuid())
  date           DateTime
  description    String
  amount         Float
  type           TransactionType
  entity         Entity
  reconciled     Boolean         @default(false)
  isTransfer     Boolean         @default(false)
  source         String          @default("manual")
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenterId   String?
  costCenter     CostCenter?     @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  reconciledAt   DateTime?
  reconciledBy   String?
  note           String?
  attachmentUrl  String?
  attachmentName String?
  dedupeKey      String?
  recurringTransactionId String?
  recurringTransaction   RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)
  loanId         String?
  loan           Loan?           @relation(fields: [loanId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt

  @@unique([accountId, dedupeKey])
  @@index([organizationId, entity, date])
  @@index([categoryId])
  @@index([recurringTransactionId])
  @@index([loanId])
}

model Loan {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity            Entity
  direction         LoanDirection
  counterparty      String
  principal         Float
  accountId         String
  account           Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId        String?
  category          Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  startDate         DateTime
  installmentCount  Int
  installmentAmount Float
  installmentDay    Int
  interestRate      Float?
  note              String?
  createdAt         DateTime      @default(now())
  transactions      Transaction[]

  @@index([organizationId, entity])
}

model RecurringTransaction {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         Entity
  type           TransactionType
  description    String
  amount         Float
  accountId      String
  account        Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenterId   String?
  costCenter     CostCenter?         @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  frequency      RecurrenceFrequency @default(MONTHLY)
  dayOfMonth     Int
  startDate      DateTime
  endDate        DateTime?
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  transactions   Transaction[]

  @@index([organizationId, entity])
}

model Budget {
  id             String       @id @default(cuid())
  month          Int
  year           Int
  entity         Entity
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  plannedAmount  Float

  @@unique([organizationId, month, year, entity, categoryId])
}
