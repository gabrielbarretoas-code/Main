generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Entity {
  PERSONAL
  BUSINESS
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  CASH
  INVESTMENT
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum UserRole {
  OWNER
  MEMBER
}

model Organization {
  id                   String             @id @default(cuid())
  name                 String
  whatsappPhone        String?            @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  trialEndsAt          DateTime?
  createdAt            DateTime           @default(now())

  users        User[]
  accounts     Account[]
  categories   Category[]
  costCenters  CostCenter[]
  transactions Transaction[]
  budgets      Budget[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String
  name           String
  role           UserRole     @default(OWNER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

model Account {
  id             String        @id @default(cuid())
  name           String
  type           AccountType
  entity         Entity
  hasAutoInvest  Boolean       @default(false)
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  transactions   Transaction[]

  @@index([organizationId])
}

model Category {
  id             String          @id @default(cuid())
  name           String
  type           TransactionType
  entity         Entity
  color          String          @default("#6366f1")
  icon           String          @default("Tag")
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children       Category[]      @relation("CategoryHierarchy")
  transactions   Transaction[]
  budgets        Budget[]

  @@unique([organizationId, name, type, entity])
  @@index([parentId])
}

model CostCenter {
  id             String        @id @default(cuid())
  name           String
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions   Transaction[]

  @@unique([organizationId, name])
}

model Transaction {
  id             String          @id @default(cuid())
  date           DateTime
  description    String
  amount         Float
  type           TransactionType
  entity         Entity
  reconciled     Boolean         @default(false)
  isTransfer     Boolean         @default(false)
  source         String          @default("manual")
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenterId   String?
  costCenter     CostCenter?     @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now())

  @@index([organizationId, entity, date])
  @@index([categoryId])
}

model Budget {
  id             String       @id @default(cuid())
  month          Int
  year           Int
  entity         Entity
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  plannedAmount  Float

  @@unique([organizationId, month, year, entity, categoryId])
}
